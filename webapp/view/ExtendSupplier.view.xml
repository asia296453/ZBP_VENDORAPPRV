<mvc:View
    controllerName="zbpvendorapprv.controller.ExtendSupplier"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
     xmlns:table="sap.ui.table">
    <Page title="" >
    <content>
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout"  >
			 <core:Fragment fragmentName="zbpvendorapprv.fragment.vendor" type="XML"/>	
	</form:SimpleForm>	
	</content>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button text="Validate" type="Accept" press=".onValidate" visible="{ui>/isEditable}" />
                <!-- <Button text="Edit" type="Emphasized" press=".onEdit" visible="{= !${ui>/isEditable} }" /> -->
                <Button text="Save as Draft" type="Transparent" press=".onSaveDraft" visible="{ui>/isValidated}" />
                <Button text="Submit" type="Emphasized" press=".onSubmitRequest" visible="{ui>/isValidated}" />
                <Button text="Cancel" type="Transparent" press=".onNavBack" />

			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>