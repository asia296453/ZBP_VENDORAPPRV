<mvc:View controllerName="zbpvendorapprv.controller.InterfaceList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <Page id="interfaceListPage" title="Vendor Interface Requests" showNavButton="true" navButtonPress=".onNavBack">
        <content>
<smartFilterBar:SmartFilterBar
    id="smartFilterBar"
    entitySet="WorkflowStatusSet"
    persistencyKey="WorkflowFilter"
    useToolbar="true">

    <smartFilterBar:controlConfiguration>

        <smartFilterBar:ControlConfiguration
            key="RequestNumber"
            label="Request Number"
            visibleInAdvancedArea="true">

            <smartFilterBar:customControl>

               <Input
                  id="idRequestNumber"
                  placeholder="Select Request Number"
                  showValueHelp="true"
                  valueHelpOnly="true"
                  valueHelpRequest=".onRequestNumberF4"/>

            </smartFilterBar:customControl>

        </smartFilterBar:ControlConfiguration>

    </smartFilterBar:controlConfiguration>

</smartFilterBar:SmartFilterBar>

            <smartTable:SmartTable
    id="smartTable"
    entitySet="WorkflowStatusSet"
    smartFilterId="smartFilterBar"
    tableType="Table"
    enableAutoBinding="true"
    useVariantManagement="true"
    useTablePersonalisation="true"
    showRowCount="true"
    persistencyKey="WorkflowTable"
    beforeRebindTable="onBeforeRebindTable"
    initiallyVisibleFields="RequestNumber,Partner,RequestBy,RequestedDate,RequestedTime,WFStatus,L1ApproverStatus,L2ApproverStatus,L3ApproverStatus,L4ApproverStatus"/>   

        </content>
    </Page>
</mvc:View>