<fb:FilterBar
    id="filterBar"
    clear="onClear"
    useToolbar="true"
    search=".onSearch"
    filterChange=".onFilterChange"
    showGoOnFB="true"
    showClearOnFB="true"
    xmlns:fb="sap.ui.comp.filterbar">

    <fb:filterGroupItems>

        <!-- Request Number -->
        <fb:FilterGroupItem
            name="RequestNumber"
            label="Request Number"
            groupName="Basic"
            visibleInFilterBar="true">

            <fb:control>
                <Input
                    id="idRequestNumber"
                    placeholder="Select Request Number"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onRequestNumberF4"/>
            </fb:control>

        </fb:FilterGroupItem>

        <!-- Request Type -->
        <fb:FilterGroupItem
            name="RequestType"
            label="Request Type"
            groupName="Basic"
            visibleInFilterBar="true">

            <fb:control>
                <ComboBox
                    id="RequestType1"
                    selectedKey="{LocalModel>/RequestType1}">

                    <items>
                        <core:Item key="CR" text="Create"/>
                        <core:Item key="CH" text="Change"/>
                        <core:Item key="EX" text="Extension"/>
                    </items>

                </ComboBox>
            </fb:control>

        </fb:FilterGroupItem>

        <!-- Supplier -->
        <fb:FilterGroupItem
            name="Partner"
            label="Supplier"
            groupName="Basic"
            visibleInFilterBar="true">

            <fb:control>
                <Input
                    id="Partner1"
                    value="{LocalModel>/Partner1}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onValueHelpRequest"
                    placeholder="Select Supplier"/>
            </fb:control>

        </fb:FilterGroupItem>

        <!-- Requested Date -->
        <fb:FilterGroupItem
            name="RequestedDate"
            label="Date of Creation"
            groupName="Basic"
            visibleInFilterBar="true">

            <fb:control>
                <DatePicker
                    id="RequestedDate"
                    value="{LocalModel>/RequestedDate}"
                    placeholder="Select Date"
                    displayFormat="dd-MM-yyyy"
                    valueFormat="yyyy-MM-dd"/>
            </fb:control>

        </fb:FilterGroupItem>

        <!-- Workflow Status -->
        <fb:FilterGroupItem
            name="WFStatus"
            label="Status"
            groupName="Basic"
            visibleInFilterBar="true">

            <fb:control>
                <ComboBox
                    id="WFStatus"
                    selectedKey="{LocalModel>/WFStatus}">

                    <items>
                        <core:Item key="STARTED" text="STARTED"/>
                        <core:Item key="COMPLETED" text="COMPLETED"/>
                        <core:Item key="ERROR" text="ERROR"/>
                    </items>

                </ComboBox>
            </fb:control>

        </fb:FilterGroupItem>

    </fb:filterGroupItems>

</fb:FilterBar>
            <smartTable:SmartTable
    id="smartTable"
    entitySet="WorkflowStatusSet"
    smartFilterId="smartFilterBar"
    tableType="Table"
    enableAutoBinding="true"
    useVariantManagement="true"
    useTablePersonalisation="true"
    showRowCount="true"
    persistencyKey="WorkflowTable"
    beforeRebindTable="onBeforeRebindTable"
    initiallyVisibleFields="RequestNumber,Partner,RequestBy,RequestedDate,RequestedTime,WFStatus,L1ApproverStatus,L2ApproverStatus,L3ApproverStatus,L4ApproverStatus"/>   

        </content>
    </Page>
</mvc:View>